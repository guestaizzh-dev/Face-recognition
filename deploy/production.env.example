# Formal environment: https://cd.chbzg.com.cn (service port 9003)
# Copy to /opt/face-verify-demo/shared/env/production.env and replace every CHANGE_ME value.
FACE_DEMO_DATABASE_PATH=/opt/face-verify-demo/shared/data/production.sqlite3
FACE_DEMO_INTERNAL_API_KEY=CHANGE_ME_PRODUCTION_INTERNAL_API_KEY
FACE_DEMO_CORS_ORIGINS=https://cd.chbzg.com.cn
FACE_DEMO_TEMPLATE_ENCRYPTION_KEY=CHANGE_ME_PRODUCTION_TEMPLATE_KEY
FACE_DEMO_TEMPLATE_ENCRYPTION_REQUIRED=1
FACE_DEMO_INSIGHTFACE_ROOT=/opt/face-verify-demo/shared/insightface-home/.insightface
FACE_DEMO_INSIGHTFACE_MODEL=buffalo_l
FACE_DEMO_ANTI_SPOOFING_MODEL_PATH=/opt/face-verify-demo/current/models/MiniFASNetV1SE.onnx,/opt/face-verify-demo/current/models/MiniFASNetV2.yakhyo.onnx
