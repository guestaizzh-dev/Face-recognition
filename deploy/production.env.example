# Production settings for 121.89.81.236. Keep the filled file outside Git at
# /opt/face-verify-demo/shared/.env and replace every CHANGE_ME value.
FACE_DEMO_RELEASE_SHA=SET_BY_DEPLOYMENT
FACE_DEMO_DATABASE_PATH=/opt/face-verify-demo/shared/data/face_verify.sqlite3

# The production SSH database tunnel must forward 127.0.0.1:13306 to the
# MySQL instance used by /www/wwwroot/leda. The production database is chbzg.
FACE_DEMO_STATE_DB_DSN=mysql+pymysql://chbzg:CHANGE_ME@127.0.0.1:13306/chbzg
FACE_DEMO_STATE_DB_TEMPLATE_TABLE=fa_face_service_template
FACE_DEMO_STATE_DB_SESSION_TABLE=fa_face_service_session
FACE_DEMO_STATE_DB_PROOF_TABLE=fa_face_service_proof
FACE_DEMO_STATE_DB_CONNECT_TIMEOUT_SECONDS=3
FACE_DEMO_STATE_DB_READ_TIMEOUT_SECONDS=5
FACE_DEMO_STATE_DB_WRITE_TIMEOUT_SECONDS=5

FACE_DEMO_INTERNAL_API_KEY=CHANGE_ME_PRODUCTION_FACE_API_KEY
FACE_DEMO_CORS_ORIGINS=https://chbzg.com,https://www.chbzg.com,https://faces.chbzg.com.cn
FACE_DEMO_VERIFICATION_SESSION_TTL_SECONDS=300
FACE_DEMO_VERIFICATION_PROCESSING_TIMEOUT_SECONDS=90
FACE_DEMO_PROOF_TTL_SECONDS=300
FACE_DEMO_TEMPLATE_ENCRYPTION_KEY=CHANGE_ME_PRODUCTION_TEMPLATE_KEY
FACE_DEMO_TEMPLATE_ENCRYPTION_REQUIRED=1

FACE_DEMO_REGULATOR_DB_ENABLED=1
FACE_DEMO_REGULATOR_DB_DSN=mysql+pymysql://chbzg:CHANGE_ME@127.0.0.1:13306/chbzg
FACE_DEMO_REGULATOR_DB_TABLE=fa_face_verify_regulator_status
FACE_DEMO_REGULATOR_DB_CONNECT_TIMEOUT_SECONDS=3
FACE_DEMO_REGULATOR_DB_READ_TIMEOUT_SECONDS=5
FACE_DEMO_REGULATOR_DB_WRITE_TIMEOUT_SECONDS=5
FACE_DEMO_DOCTOR_FACE_LOG_ENABLED=1
FACE_DEMO_DOCTOR_FACE_LOG_TABLE=fa_doctor_face_verify_log

# Use the same InsightFace and anti-spoofing models as the verified test service.
FACE_DEMO_INSIGHTFACE_MODEL=buffalo_l
FACE_DEMO_INSIGHTFACE_ROOT=/opt/face-verify-demo/shared/insightface-root/.insightface
FACE_DEMO_INSIGHTFACE_DET_SIZE=480
FACE_DEMO_INSIGHTFACE_LIVE_DET_SIZE=320
FACE_DEMO_INSIGHTFACE_CTX_ID=-1
FACE_DEMO_ANTI_SPOOFING_MODEL_PATH=/opt/face-verify-demo/shared/models/MiniFASNetV1SE.onnx,/opt/face-verify-demo/shared/models/MiniFASNetV2.yakhyo.onnx
FACE_DEMO_ANTI_SPOOFING_MODEL_SCALES=4.0,2.7
FACE_DEMO_ANTI_SPOOFING_THRESHOLD=0.35

# Keep production behavior aligned with the current test environment.
FACE_DEMO_VERIFICATION_MAX_CONCURRENT_REQUESTS=1
FACE_DEMO_INSIGHTFACE_MAX_CONCURRENT_INFERENCES=1
FACE_DEMO_ANTI_SPOOFING_MAX_CONCURRENT_INFERENCES=1
FACE_DEMO_ONNX_INTRA_OP_THREADS=2
FACE_DEMO_ONNX_INTER_OP_THREADS=1
FACE_DEMO_MAX_IMAGE_PIXELS=1228800
FACE_DEMO_MAX_IMAGE_DIMENSION=1280
FACE_DEMO_VERIFICATION_FAILURE_LIMIT_ENABLED=1
FACE_DEMO_VERIFICATION_FAILURE_MAX_ATTEMPTS=3
FACE_DEMO_VERIFICATION_FAILURE_WINDOW_SECONDS=300
FACE_DEMO_VERIFICATION_FAILURE_COOLDOWN_SECONDS=60
FACE_DEMO_VERIFICATION_FAILURE_EXEMPT_SCENES=doctor_audit
FACE_DEMO_MIN_FRAMES_PER_ACTION=8
FACE_DEMO_SMILE_DELTA_THRESHOLD=0.015
FACE_DEMO_SHAKE_YAW_RANGE_THRESHOLD=4.0
FACE_DEMO_NOD_PITCH_RANGE_THRESHOLD=3.0
FACE_DEMO_HEAD_AXIS_CROSS_TOLERANCE_DEGREES=16.0
FACE_DEMO_HEAD_AXIS_CROSS_RANGE_RATIO=1.20
